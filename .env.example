# Docker Compose local settings
FRONTEND_PORT=5173
POSTGRES_DB=ymall
POSTGRES_USER=ymall_user
POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me_to_a_random_secret_at_least_32_bytes

# OAuth2 provider credentials (optional for non-OAuth local flows)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Toss Payments test keys (use a matching test_ck/test_sk pair)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_API_BASE_URL=https://api.tosspayments.com

# SMTP settings (optional for flows that do not send email)
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ymall.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
