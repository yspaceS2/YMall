# Docker Compose local settings
FRONTEND_PORT=5173
POSTGRES_DB=ymall
POSTGRES_USER=ymall_user
POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me_to_a_random_secret_at_least_32_bytes

# OAuth2 provider credentials (optional for non-OAuth local flows)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Toss Payments test keys (use a matching test_ck/test_sk pair)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_API_BASE_URL=https://api.tosspayments.com

# SMTP settings (optional for flows that do not send email)
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ymall.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
MAILHOG_HTTP_PORT=8025

# AI review summary model (Docker Model Runner)
AI_REVIEW_MODEL=hf.co/Qwen/Qwen3-0.6B-GGUF:Q8_0
AI_REVIEW_CONTEXT_SIZE=4096
AI_REVIEW_MAX_TOKENS=192
AI_REVIEW_THREADS=4
AI_REVIEW_PARALLEL=1
AI_REVIEW_GPU_LAYERS=0
AI_REVIEW_REQUEST_TIMEOUT_SECONDS=180
AI_REVIEW_ENABLED=true
AI_REVIEW_MINIMUM_REVIEWS=10
AI_REVIEW_MAXIMUM_REVIEWS=100
AI_REVIEW_MAXIMUM_REVIEW_LENGTH=1000
AI_REVIEW_MAXIMUM_TOTAL_LENGTH=6000
AI_REVIEW_CONNECT_TIMEOUT=3s
AI_REVIEW_READ_TIMEOUT=180s
AI_REVIEW_LOCK_TTL=5m
REVIEW_SUMMARY_CACHE_TTL=30m

# k6 load test
LOAD_TEST_SCENARIO=read
LOAD_TEST_BASE_URL=http://backend:8080/api
LOAD_TEST_PRODUCT_ID=
LOAD_TEST_SEARCH_KEYWORD=
LOAD_TEST_USER_EMAILS=
LOAD_TEST_USER_PASSWORDS=
LOAD_TEST_ADDRESS_ID=
LOAD_TEST_ENABLE_WRITES=false
LOAD_TEST_TARGET_VUS=10
LOAD_TEST_RAMP_UP=30s
LOAD_TEST_HOLD=1m
LOAD_TEST_RAMP_DOWN=30s
LOAD_TEST_SPIKE_BASE_VUS=5
LOAD_TEST_SPIKE_VUS=50
LOAD_TEST_SPIKE_WARM_UP=20s
LOAD_TEST_SPIKE_DURATION=30s
LOAD_TEST_SPIKE_RECOVERY=30s
LOAD_TEST_P95_MS=500
LOAD_TEST_FAILURE_RATE=0.01
LOAD_TEST_THINK_TIME=1
LOAD_TEST_REFRESH_EVERY=20
LOAD_TEST_WRITE_EVERY=10

# Pending payment order expiration
PENDING_ORDER_EXPIRATION_ENABLED=true
PENDING_ORDER_EXPIRATION_TIMEOUT=30m
PENDING_ORDER_EXPIRATION_BATCH_SIZE=100
PENDING_ORDER_EXPIRATION_POLL_INTERVAL=1m

# Local monitoring ports
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000
# Host ports used by IntelliJ, Vite, and local integration tests.
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
