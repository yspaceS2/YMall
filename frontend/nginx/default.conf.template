server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) {
        return 405;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://accounts.google.com/gsi/client https://t1.kakaocdn.net https://js.tosspayments.com; style-src 'self' https://accounts.google.com/gsi/style; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://accounts.google.com/gsi/ https://log.tosspayments.com https://event.tosspayments.com; frame-src https://accounts.google.com/gsi/ https://pay.toss.im https://postcode.map.daum.net; worker-src 'self' blob:" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    location ^~ /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        include /etc/nginx/proxy_params;
    }

    location ^~ /images/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        include /etc/nginx/proxy_params;
    }

    location ^~ /oauth2/authorization/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        include /etc/nginx/proxy_params;
    }

    location ^~ /login/oauth2/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        include /etc/nginx/proxy_params;
    }

    location = /index.html {
        expires -1;
    }

    location = /theme-init.js {
        expires -1;
    }

    location ~* \.(?:css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2)$ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
