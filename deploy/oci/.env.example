# Public deployment values
YMALL_DOMAIN=ymall.cloud
ACME_EMAIL=admin@example.com
CORS_ALLOWED_ORIGINS=https://ymall.cloud
OAUTH2_FRONTEND_REDIRECT_URI=https://ymall.cloud/oauth2/callback

# PostgreSQL
POSTGRES_DB=ymall
POSTGRES_USER=ymall_user
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Application secrets
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
SELLER_SETTLEMENT_ACCOUNT_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key

# OAuth2 providers
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
KAKAO_CLIENT_ID=replace_me
KAKAO_CLIENT_SECRET=replace_me
NAVER_CLIENT_ID=replace_me
NAVER_CLIENT_SECRET=replace_me

# Toss Payments test keys for the portfolio deployment
TOSS_CLIENT_KEY=replace_with_test_client_key
TOSS_SECRET_KEY=replace_with_test_secret_key

# SMTP provider
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_me
MAIL_PASSWORD=replace_me
MAIL_FROM=noreply@ymall.cloud
MAIL_HEALTH_ENABLED=true
