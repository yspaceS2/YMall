{
    email {$ACME_EMAIL}
}

www.{$YMALL_DOMAIN:ymall.cloud} {
    redir https://{$YMALL_DOMAIN:ymall.cloud}{uri} permanent
}

{$YMALL_DOMAIN:ymall.cloud} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    @backend path /api/* /images/* /oauth2/authorization/* /login/oauth2/* /ws* /actuator/health /actuator/health/*

    handle @backend {
        header {
            Cross-Origin-Resource-Policy "same-origin"
            defer
        }
        reverse_proxy backend:8080
    }

    handle {
        reverse_proxy frontend:8080
    }
}
